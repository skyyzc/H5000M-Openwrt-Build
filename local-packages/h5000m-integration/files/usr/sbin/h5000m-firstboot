#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# h5000m-firstboot — product defaults that make a freshly flashed H5000M usable
# without logging in first.
#
# Called from three places, all of which funnel into the same idempotent code:
#
#   /etc/uci-defaults/92-h5000m-defaults          first boot
#   /etc/hotplug.d/ieee80211/20-h5000m-defaults   when a radio appears
#
# The hotplug path exists because /etc/config/wireless does NOT ship in the
# image: it is generated by /sbin/wifi config, which the image's own
# /etc/hotplug.d/ieee80211/10-wifi-detect runs on radio hotplug.  A uci-defaults
# script alone can therefore run before any radio section exists and configure
# nothing.  Numbering this script 20 puts it after 10-wifi-detect, so the
# sections are there.
#
# Everything is applied once, guarded by a marker that sysupgrade preserves
# (lib/upgrade/keep.d/h5000m-defaults), so a later image never resets settings
# the owner has changed.

[ -n "${IPKG_INSTROOT:-}" ] && exit 0

# Two independent markers, because the two defaults become possible at
# different times.  A single marker taken when /etc/config/wireless merely EXISTS
# was wrong: the image ships that file empty, so on the first boot the wireless
# pass finds no radio, does nothing, and still burned the marker — after which
# the ieee80211 hotplug that later creates the radios would see the marker and
# skip for ever.  WiFi would never be configured at all.
#
# Separate markers also stop the offload being re-applied on every boot until a
# radio shows up, which would keep overwriting the owner's own changes to it.
MARKER_WIFI='/etc/h5000m-wifi-applied'
MARKER_OFFLOAD='/etc/h5000m-offload-applied'

# The three settings below deliberately have NO marker.  Each one guards itself
# on a property of the thing it is about to change, so re-running is a no-op and
# a value the owner has since changed is never reset:
#
#   timezone  — only written while the config still reads as untouched
#               (GMT0/UTC); once it says CST-8 the function returns immediately
#   worker    — the file is only created when it does not exist
#   guard     — the crontab line is only appended when it is not already there
#
# A marker would be strictly worse here: it is stored in /etc and preserved
# across sysupgrade, so a unit whose owner deleted the file or cleared the
# crontab by accident could never be repaired by a reflash.

# The values below are written by scripts/local-build.sh into
# /etc/h5000m-defaults.conf at build time, so the SSID, key, country and the
# offload switches are build inputs rather than constants.  The fallbacks keep
# the script working if that file is ever missing.
H5000M_WIFI_SSID='Higoros-H5000M'
H5000M_WIFI_SSID_2G='Higoros-H5000M-2.4G'
H5000M_WIFI_SSID_5G='Higoros-H5000M-5G'
H5000M_WIFI_KEY='H987654321'
H5000M_WIFI_COUNTRY='CN'
H5000M_WIFI_ENCRYPTION='sae-mixed'
# Channel width.  Both defaults used to be the widest the chip can do, which is
# the wrong trade on a real site:
#
#   2.4 GHz has three non-overlapping channels (1/6/11).  EHT40 there ALWAYS
#   overlaps a neighbour, so in any built-up area it measures slower than 20 MHz
#   while raising retries for everyone.  EHT20 is the honest setting.
#
#   5 GHz in CN is 36-64 plus 149-165, and 52-64 are DFS.  EHT160 starting at 36
#   necessarily spans 36-64, so the AP must pass radar detection (CAC) before it
#   comes up and must move channel if radar appears — visible to the owner as
#   "5 GHz is missing for a while" and then "5 GHz dropped".  The 5.8 GHz block
#   is not contiguous, so 160 MHz cannot be had there either.  EHT80 at 36 spans
#   36-48, entirely non-DFS: up immediately, never kicked off.
#
# Note the EHT prefix is mandatory on this WiFi 7 target: wifi-scripts rejects a
# bare "HT80" outright (valid set is NOHT/HT20/HT40*/VHT*/HE*/EHT*), and a
# rejected htmode takes the whole radio down.  Measured on the device.
H5000M_WIFI_HTMODE_2G='EHT20'
H5000M_WIFI_HTMODE_5G='EHT80'
H5000M_FLOW_OFFLOAD='1'
H5000M_FLOW_OFFLOAD_HW='1'

# 2026-10-31: qmodem-worker、qmodem-worker.conf 及其 interval 常量整组删除。
# 上游 luci-app-qmodem-generic 在新 pin 里不再提供 worker，改由
# qmodem-stats-loop 在后台 60 s 采样（采样已完全移出 RPC），我们的
# /etc/qmodem-worker.conf 调参手段随之失效，留着只是死代码。
# shellcheck source=/dev/null
[ -f /etc/h5000m-defaults.conf ] && . /etc/h5000m-defaults.conf

log() { logger -t h5000m-firstboot "$@" 2>/dev/null || true; }

# --------------------------------------------------------------- wireless ----
# A freshly flashed OpenWrt leaves every radio disabled until someone logs in
# and sets a country, which reads as "WiFi is broken" on a device whose whole
# point is being a 5G CPE.  Turn the radios on with a documented default.
#
# The guard is deliberately conservative: if ANY AP interface already carries a
# non-default SSID the owner has configured wireless, and nothing is touched.
# Returns 0 only when it actually applied the defaults.  "No radio sections yet"
# and "the owner already configured this" both return 1, so the caller does not
# record the work as done.
configure_wireless() {
	[ -f /etc/config/wireless ] || return 1

	local iface radio pkg dev band ssid configured=0 custom=0

	# "Unconfigured" covers BOTH the factory names (OpenWrt ships with
	# OpenWrt/openwrt/empty) AND every name this image can write on an earlier
	# boot: the two per-band names AND the base name they are derived from.
	#
	# The base name is on that list because it is exactly what a half-applied
	# state looks like — the SSID was set before the per-band split existed, or
	# a run stopped between the two interfaces.  Leaving it off the list made
	# the guard read it as "the owner's choice" and freeze the device on the
	# base name for ever, silently: measured on real hardware, the run returned
	# 1, wrote no marker, logged nothing, and the SSIDs never reached
	# -2.4G/-5G.  An owner who sets an SSID that happens to equal the build's
	# base name is far less likely than that state, and the change is visible.
	for iface in $(uci -q show wireless | sed -n 's/^\(wireless\.[^.]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get "${iface}.mode")" = 'ap' ] || continue
		ssid="$(uci -q get "${iface}.ssid" 2>/dev/null || true)"
		if [ -z "$ssid" ] || [ "$ssid" = 'OpenWrt' ] || [ "$ssid" = 'openwrt' ] ||
			[ "$ssid" = "$H5000M_WIFI_SSID" ] ||
			[ "$ssid" = "$H5000M_WIFI_SSID_2G" ] || [ "$ssid" = "$H5000M_WIFI_SSID_5G" ]; then
			configured=1
		else
			custom=1
		fi
	done

	[ "$custom" = '0' ] || return 1
	[ "$configured" = '1' ] || return 1

	for radio in $(uci -q show wireless | sed -n 's/^\(wireless\.[^.]*\)=wifi-device$/\1/p'); do
		band="$(uci -q get "${radio}.band")"
		uci -q set "${radio}.country=${H5000M_WIFI_COUNTRY}"
		uci -q set "${radio}.disabled=0"
		case "$band" in
			2g) uci -q set "${radio}.htmode=${H5000M_WIFI_HTMODE_2G}" ;;
			5g) uci -q set "${radio}.htmode=${H5000M_WIFI_HTMODE_5G}" ;;
		esac
	done

	for iface in $(uci -q show wireless | sed -n 's/^\(wireless\.[^.]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get "${iface}.mode")" = 'ap' ] || continue

		# The band is declared on the radio an interface sits on, reached through
		# its `device`.  That option holds a BARE section name (`radio0`), which
		# `uci get` cannot resolve by itself — it needs the package name, and
		# that is the part of the interface's own name before the first dot.
		# `uci -q get radio0.band` returns EMPTY (measured), which silently sent
		# both bands to the fallback name below instead of failing.
		# Deriving the package beats hardcoding "wireless.": the loop already
		# works on fully-qualified names, and a hardcoded prefix goes stale the
		# day the config moves.
		pkg="${iface%%.*}"
		dev="$(uci -q get "${iface}.device")"
		band=''
		[ -n "$dev" ] && band="$(uci -q get "${pkg}.${dev}.band")"
		case "$band" in
			2g) ssid="${H5000M_WIFI_SSID_2G}" ;;
			5g) ssid="${H5000M_WIFI_SSID_5G}" ;;
			*) ssid="${H5000M_WIFI_SSID}" ;;
		esac

		# bss_transition must stay unset: the official compact wpad variant
		# does not know that hostapd option and rejects the whole AP config.
		uci -q delete "${iface}.bss_transition"
		uci -q set "${iface}.ssid=${ssid}"
		uci -q set "${iface}.encryption=${H5000M_WIFI_ENCRYPTION}"

		# An open network has no key and no management-frame protection: leaving
		# an empty `key` option behind, or asking for PMF on an unencrypted
		# interface, makes hostapd reject the whole AP configuration rather than
		# simply ignoring the extra options.
		if [ "${H5000M_WIFI_ENCRYPTION}" = 'none' ] || [ -z "${H5000M_WIFI_KEY}" ]; then
			uci -q delete "${iface}.key"
			uci -q delete "${iface}.ieee80211w"
		else
			uci -q set "${iface}.key=${H5000M_WIFI_KEY}"
			uci -q set "${iface}.ieee80211w=1"
		fi
		uci -q set "${iface}.ieee80211k=1"
		uci -q set "${iface}.disabled=0"
	done

	uci -q commit wireless
	log "wireless enabled: ssid2g=${H5000M_WIFI_SSID_2G} ssid5g=${H5000M_WIFI_SSID_5G} country=${H5000M_WIFI_COUNTRY} encryption=${H5000M_WIFI_ENCRYPTION}"
	return 0
}

# ------------------------------------------------- flow offload / hardware ---
# This IS the H5000M's hardware acceleration on mainline.
#
# The TurboACC panel shipped by ImmortalWrt and the vendor forks drives the
# out-of-tree MTK "HNAT" driver through /sys/kernel/debug/hnat/.  Mainline has
# no such driver — no mtk_hnat, no turboacc, no shortcut-fe anywhere in the
# tree — so that panel cannot work here at all.
#
# What mainline has instead is mtk_ppe_offload.c: the same PPE hardware, driven
# through the standard netfilter flowtable offload API (flow_cls_offload).  For
# the MT7987 it is fully wired up — mtk_eth_soc's mt7987_data declares
# .offload_version = 2 and .ppe_num = 2, mtk_ppe_init() is called for both PPEs,
# and the required nft_flow_offload / nf_flow_table modules are in the image.
#
# So the feature is present and only switched off: fw4 defaults both
# flow_offloading and flow_offloading_hw to "0", and the stock
# /etc/config/firewall sets neither.  Enabling them is what "turning on
# hardware acceleration" means on this firmware, and the owner can see and
# change both from LuCI (Network -> Firewall -> General Settings).
configure_offload() {
	[ -f /etc/config/firewall ] || return 1

	uci -q get firewall.@defaults[0] >/dev/null 2>&1 || return 1

	uci -q set "firewall.@defaults[0].flow_offloading=${H5000M_FLOW_OFFLOAD}"
	uci -q set "firewall.@defaults[0].flow_offloading_hw=${H5000M_FLOW_OFFLOAD_HW}"
	uci -q commit firewall
	log "flow offload: software=${H5000M_FLOW_OFFLOAD} hardware=${H5000M_FLOW_OFFLOAD_HW}"
	return 0
}

# ----------------------------------------------------------------- timezone ---
# A fresh OpenWrt comes up in UTC, so every timestamp the owner reads on this
# box — logread, `ls -la`, the firmware page — sits 8 hours behind Beijing time.
# Matching a log line against a wall clock then goes wrong by exactly the same
# 8 hours, which is how it was eventually noticed.
#
# OpenWrt uses POSIX TZ notation, where the sign is inverted relative to the
# offset people quote: east of Greenwich is CST-8, not CST+8.
#
# Guard: write only while the config still reads as untouched.  The board
# shipped as GMT0 and stock OpenWrt ships UTC, so both spellings are accepted.
# Anything else is the owner's own setting and is left alone — which is why this
# needs no marker.
configure_timezone() {
	[ -f /etc/config/system ] || return 1

	local tz zn
	tz="$(uci -q get system.@system[0].timezone 2>/dev/null)"
	zn="$(uci -q get system.@system[0].zonename 2>/dev/null)"

	case "$tz" in
		''|UTC|GMT|GMT0|Etc/UTC|Etc/GMT) ;;
		*) return 1 ;;
	esac
	case "$zn" in
		''|UTC|GMT|Etc/UTC|Etc/GMT) ;;
		*) return 1 ;;
	esac

	uci -q set system.@system[0].timezone='CST-8'
	uci -q set system.@system[0].zonename='Asia/Shanghai'
	uci -q commit system
	log "timezone: CST-8 / Asia/Shanghai (was '${tz}' / '${zn}')"
	return 0
}

# ------------------------------------------------------- rpcd memory guard ---
# rpcd on this board leaks the output buffer of external-script ubus methods and
# never gives it back (measured: 370-524 kB/min, ≈ 750 MB/day, which reached
# 619 MB and left 18 MB available with load 21).  The watchdog restarts the
# service above a 64 MB threshold; that restart was measured to cost nothing —
# all 64 ubus objects come back and WiFi / 5G / the upgrade channel are
# unaffected.
#
# The crontab entry is the only thing that has to exist for it to run at all, so
# it is written idempotently rather than once: a marker would make an erased
# crontab unrepairable by a reflash.
#
# What this will not do: touch any other crontab line.  It only appends.
configure_guard() {
	[ -x /usr/sbin/h5000m-rpcd-guard.sh ] || return 1

	local ct='/etc/crontabs/root'
	mkdir -p /etc/crontabs 2>/dev/null
	[ -f "$ct" ] || : >"$ct"

	if ! grep -qE '^[[:space:]]*[^#[:space:]].*h5000m-rpcd-guard\.sh' "$ct" 2>/dev/null; then
		printf '* * * * * /usr/sbin/h5000m-rpcd-guard.sh\n' >>"$ct"
		chmod 0600 "$ct" 2>/dev/null
		log "rpcd guard: cron entry installed"
		/etc/init.d/cron enable >/dev/null 2>&1
		/etc/init.d/cron restart >/dev/null 2>&1
	fi

	/etc/init.d/cron enabled >/dev/null 2>&1 || /etc/init.d/cron enable >/dev/null 2>&1
	return 0
}

# ------------------------------------------- higorosd traffic loop watchdog ---
# 2026-10-21 实机：把 wrtbwmon 的库钉到 /tmp/usage.db 之后，流量列在手工重启
# higorosd 后正常，但**开机后大概率不动**（5 次开机里 4 次 state 的 mtime
# 冻结在开机后几秒，todayMb 恒 0，而 /tmp/usage.db 仍在每 5 秒累加）。
# 手工 restart 之后 6 次全部正常，且 todayMb 立刻按库里的累计值算出来 —— 不丢数据。
# 根因在二进制内部（无日志可读），已排除的假设见 /usr/sbin/h5000m-higoros-guard.sh 头注释。
#
# 同一个 cron 安装约定：只追加自己那一行，绝不动别人的行。
configure_higoros_guard() {
	[ -x /usr/sbin/h5000m-higoros-guard.sh ] || return 1

	local ct='/etc/crontabs/root'
	mkdir -p /etc/crontabs 2>/dev/null
	[ -f "$ct" ] || : >"$ct"

	if ! grep -qE '^[[:space:]]*[^#[:space:]].*h5000m-higoros-guard\.sh' "$ct" 2>/dev/null; then
		printf '* * * * * /usr/sbin/h5000m-higoros-guard.sh\n' >>"$ct"
		chmod 0600 "$ct" 2>/dev/null
		log "higoros guard: cron entry installed"
		/etc/init.d/cron enable >/dev/null 2>&1
		/etc/init.d/cron restart >/dev/null 2>&1
	fi

	/etc/init.d/cron enabled >/dev/null 2>&1 || /etc/init.d/cron enable >/dev/null 2>&1
	return 0
}

# ------------------------------------------------ device ledger collector ---
# The HigoOS "devices" page does not sample anything itself: it renders
# /api/v1/devices, which is a plain read of /tmp/higoros-devices-cache.json
# (persisted to /etc/higoros/higoros-devices-cache.json).
#
# higorosd's own device collector does not keep that file up to date on this
# board.  Measured twice (boot, and after an explicit restart): the modem,
# speed and traffic caches all refresh, while the device cache never gets its
# first write — so the page stays empty forever, not just for a while.
#
# The inputs are all healthy, which is why a collector of our own works:
#   /etc/usage.db      wrtbwmon, 10 columns, MAC/IP/traffic per client
#   /tmp/dhcp.leases   names and lease validity
#   iw ... station     wired vs wireless
# See 5G-CPE-H5000M/设备管理页根因定案-20261016.md for the evidence.
#
# Same shape as configure_guard: the crontab line is the only thing that makes
# it run, so it is appended idempotently rather than behind a marker — a marker
# would make an erased crontab unrepairable by a reflash.
configure_devices() {
	[ -x /usr/sbin/h5000m-devices-collect.sh ] || return 1

	local ct='/etc/crontabs/root'
	mkdir -p /etc/crontabs 2>/dev/null
	[ -f "$ct" ] || : >"$ct"

	if ! grep -qE '^[[:space:]]*[^#[:space:]].*h5000m-devices-collect\.sh' "$ct" 2>/dev/null; then
		printf '* * * * * /usr/sbin/h5000m-devices-collect.sh\n' >>"$ct"
		chmod 0600 "$ct" 2>/dev/null
		log "devices collector: cron entry installed"
		/etc/init.d/cron enable >/dev/null 2>&1
		/etc/init.d/cron restart >/dev/null 2>&1
	fi

	/etc/init.d/cron enabled >/dev/null 2>&1 || /etc/init.d/cron enable >/dev/null 2>&1

	# Populate once right away: waiting up to a minute for the first tick
	# looks exactly like the bug this is here to fix.
	[ -f /tmp/higoros-devices-cache.json ] ||
		/usr/sbin/h5000m-devices-collect.sh >/dev/null 2>&1 &

	return 0
}

# --------------------------------------------------------- SMS alignment ---
# 2026-10-22 实机：设备上有两套短信栈。qmodem-smsd 把短信写进
# /etc/qmodem/sms.sqlite3 并从 SIM 删掉（auto_delete），而 HigoOS(higorosd)
# 只认自己的 /etc/qmodem/2_1_received.json —— 结果海狗短信页从 10/14 原厂
# 固件之后就没再新增过（库里 9 条，海狗只有 1 条）。
#
# 实测出的两条硬约束：
#   1. higorosd 只在启动时读一次该文件；
#   2. 每次 ubus 调 qmodem_sms list_sms 它都用内存内容把文件覆写回去。
# 所以「改文件不重启」等于白改，对齐脚本必须带一次 restart（限频 120s）。
configure_sms_align() {
	[ -x /usr/sbin/h5000m-sms-align.sh ] || return 1

	local ct='/etc/crontabs/root'
	mkdir -p /etc/crontabs 2>/dev/null
	[ -f "$ct" ] || : >"$ct"

	if ! grep -qE '^[[:space:]]*[^#[:space:]].*h5000m-sms-align\.sh' "$ct" 2>/dev/null; then
		printf '*/2 * * * * /usr/sbin/h5000m-sms-align.sh\n' >>"$ct"
		chmod 0600 "$ct" 2>/dev/null
		log "sms align: cron entry installed"
		/etc/init.d/cron enable >/dev/null 2>&1
		/etc/init.d/cron restart >/dev/null 2>&1
	fi

	/etc/init.d/cron enabled >/dev/null 2>&1 || /etc/init.d/cron enable >/dev/null 2>&1

	# 开机先把历史补上，别等两分钟——用户开机第一件事就是看这个页面。
	/usr/sbin/h5000m-sms-align.sh >/dev/null 2>&1 &

	return 0
}

# ------------------------------------------------------- metrics rotation ---
# /tmp/higoros/resource-metrics-db.json 与 cpe-speed-history.json 都不滚动：
# 实测 5 秒一条、18 小时 1.9 MB（≈75 MB/月），而 /tmp 是 492 MB 的 tmpfs。
# 不裁剪的话跑几个月会把 tmpfs 吃满，之后 higorosd 写失败又是一类「面板不动」。
configure_metrics_rotate() {
	[ -x /usr/sbin/h5000m-metrics-rotate.sh ] || return 1

	local ct='/etc/crontabs/root'
	mkdir -p /etc/crontabs 2>/dev/null
	[ -f "$ct" ] || : >"$ct"

	if ! grep -qE '^[[:space:]]*[^#[:space:]].*h5000m-metrics-rotate\.sh' "$ct" 2>/dev/null; then
		printf '17 * * * * /usr/sbin/h5000m-metrics-rotate.sh\n' >>"$ct"
		chmod 0600 "$ct" 2>/dev/null
		log "metrics rotate: cron entry installed"
		/etc/init.d/cron enable >/dev/null 2>&1
		/etc/init.d/cron restart >/dev/null 2>&1
	fi

	/etc/init.d/cron enabled >/dev/null 2>&1 || /etc/init.d/cron enable >/dev/null 2>&1
	return 0
}

main() {
	# Each default is applied once, independently, and only after it actually
	# took effect.  Re-running is safe either way — the guards inside make both
	# passes no-ops when there is nothing to do or the owner has changed things.
	if [ ! -e "$MARKER_WIFI" ]; then
		if configure_wireless; then
			touch "$MARKER_WIFI"
			chmod 0600 "$MARKER_WIFI"
		fi
	fi

	if [ ! -e "$MARKER_OFFLOAD" ]; then
		if configure_offload; then
			touch "$MARKER_OFFLOAD"
			chmod 0600 "$MARKER_OFFLOAD"
		fi
	fi

	# Idempotent and self-guarding, so these run on every invocation rather than
	# behind a marker — see the note above MARKER_WIFI.  Between them they cost
	# a few uci reads and a stat, and they are what repairs a unit whose
	# timezone or crontab was lost or never applied.
	configure_timezone
	configure_guard
	configure_higoros_guard
	configure_devices
	configure_sms_align
	configure_metrics_rotate

	return 0
}

main "$@"
exit 0
