#
# configs/h5000m.config — always-on base configuration for the Hiveton H5000M.
#
# Copied to .config before `make defconfig`.  Feature blocks driven by the
# ENABLE_* switches are appended by scripts/local-build.sh afterwards, so this
# file holds only the target selection and the things this board needs in order
# to be a router at all.
#
# Target: MediaTek MT7987A (Filogic 860) + MT7992 Wi-Fi 7, 2x 2.5GbE.
# Device support comes from OpenWrt itself — target/linux/mediatek/image/
# filogic.mk :: Device/hiveton_h5000m.  We do not maintain a DTS, a port layout
# or a kernel patch for this board; the only tree patch is the fan policy one
# in ../patches/.
#

# --------------------------------------------------------------- target ------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_hiveton_h5000m=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_IMAGES_GZIP=y

# Do not build every package on the planet — image size and build time.
CONFIG_ALL=n
CONFIG_ALL_KMODS=n
CONFIG_ALL_NONSHARED=n

# ------------------------------------------- upstream `Hardware support` -----
# One line, and it is the difference between a buildable tree and a red one.
#
# 2026-09-29 upstream introduced package/system/hardware-support: nine feature
# gates (audio / video / accel / input / dvb / kvm / printer / scanner / hidraw),
# all `default m if ALL||ALL_KMODS`.  This board sets ALL_KMODS=n, so every one
# of them is `n` — which is correct, the H5000M has no input or display devices.
#
# The problem is what a *selector* does with a gate it cannot satisfy.  Measured
# on tree d09134f6 (run 37576883184), the QModem closure is gated like this:
#
#   qmodem --select--> usbutils --select--> libudev  (offered by libudev-zero)
#          --select--> libevdev --DEPENDS:=input-support--> gate, which is n
#
# libevdev declares that dependency *bare* (no `+`, i.e. "I need this" rather
# than "build this for me"), and package-metadata.pl re-emits the depends of a
# selected package onto every package that selects it, transitively.  So the
# gate lands on PACKAGE_qmodem, PACKAGE_luci-app-qmodem-next and
# PACKAGE_luci-app-qmodem-generic as
#
#   depends on PACKAGE_input-support      (no ||, no &&, no !)
#
# A single false `depends on` hides the prompt, and kconfig then writes NO line
# for the symbol at all — not even `# ... is not set`.  The survival gate reads
# that as "qmodem was dropped" and refuses to ship, correctly.  It does this to
# the entire HID/input family too: kmod-hid, kmod-input-evdev, all six
# kmod-bluetooth-*, python3-pyudev, libvulkan-broadcom, gzdoom, vice — none of
# them anything to do with us.
#
# Enabling the gate is the minimal repair, and it is nearly free: input-support
# installs one hotplug rule and allocates the `input` group (gid 41).  It does
# NOT select kmods — kmod-input-evdev and friends stay off unless something asks
# for them, so this does not put HID support into the image.
#
# This is a workaround, not a fix.  Remove it (and this comment) when libevdev
# stops carrying a bare dependency on a `default n` gate, or when upstream lets
# a selector satisfy such a gate itself.
CONFIG_PACKAGE_input-support=y

# ------------------------------------------------------------ build host -----
# Per-package build logs are NOT enabled here.
#
# The obvious spelling is `CONFIG_BUILD_LOG=y`, and it used to be in this file —
# but that symbol is declared `bool "Enable log files during build process"
# if DEVEL` (config/Config-devel.in), so without CONFIG_DEVEL it is invisible
# and defconfig drops it silently, exactly like CONFIG_CCACHE noted further
# down.  Measured on the generated .config: CONFIG_BUILD_LOG_DIR="" is present
# and CONFIG_BUILD_LOG is not, i.e. the line did nothing.
#
# scripts/local-build.sh therefore passes BUILD_LOG=1 and BUILD_LOG_DIR to make
# directly, which bypasses the visibility rule.  What that buys: each package's
# full build output is kept in <repo>/logs/<package>/<step>.txt, and a failing
# target is named in logs/<subdir>/error.txt — so a failure explains itself
# instead of being "ERROR: package/X failed to build." with no reason.
#
# Do NOT add CONFIG_DEVEL=y to fix that: it also turns on debug information and
# other developer behaviour for the whole build.

# ------------------------------------------------------------------ LuCI -----
# The board ships as an HTTPS admin UI in Simplified Chinese.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# Simplified Chinese is selected through LuCI's language gate, not by naming
# the translation packages.  The kconfig symbol is LUCI_LANG_zh_Hans (it follows
# the po/ directory name) while the packages are luci-i18n-<app>-zh-cn, and each
# of those defaults to `LUCI_LANG_zh_Hans` and depends on its own app.  Setting
# the language here therefore turns on zh-cn for every installed LuCI app,
# including luci-app-h5000m-fancontrol and luci-app-h5000m-netmode — listing the
# translation packages individually does not work, because their symbol defaults
# to "not set" and defconfig drops them.
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh_Hant=n
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ------------------------------------------------------------ base system ----
CONFIG_PACKAGE_jshn=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y

# --------------------------------------------------------------- storage -----
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# ------------------------------------------------------------ diagnostics ----
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
# ttyd alone installs only the daemon: without its LuCI app there is no page to
# reach the web terminal from, so the daemon is present but unusable.  Both
# FAN789's builder and the vendor defconfig ship the pair.
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# --------------------------------------------------------------- IPv6 -------
# The stock mt7987_mt7992 profile turns IPV6 on but leaves most of the IPv6
# netfilter chain off.  A 5G CPE with a delegated /64 needs the full stack.
CONFIG_PACKAGE_kmod-nf-ipt6=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables-extra=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-ip6-tunnel=y
CONFIG_PACKAGE_libip6tc=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_ip6tables-extra=y
CONFIG_PACKAGE_ip6tables-nft=y

# ------------------------------------------------------------ eBPF proxy ----
# Nikki-RS (CHKayanami/OpenWrt-nikki-rs, clash-rs core) can accelerate the
# transparent proxy with an eBPF datapath: TC (clsact) programs on the LAN/WAN
# interfaces, plus cgroup programs for host/process matching when cgroup v2 is
# mounted.
#
# The TC half needs no symbol here.  kmod-sched-core and kmod-sched-bpf are
# emitted as =y by scripts/local-build.sh, and their KCONFIG brings
# CONFIG_NET_SCH_INGRESS / CONFIG_NET_CLS_ACT / CONFIG_NET_CLS_BPF /
# CONFIG_NET_ACT_BPF with them.
#
# The cgroup half does: mainline's generic kernel config ships
# `# CONFIG_CGROUPS is not set`, so CONFIG_CGROUP_BPF (which sits behind it) is
# off as well.  Both are declared OpenWrt symbols in config/Config-kernel.in, so
# they survive `make defconfig` and include/kernel-defaults.mk copies them into
# the kernel config:
#
#   CONFIG_KERNEL_CGROUPS=y
#   CONFIG_KERNEL_CGROUP_BPF=y
#
# So does BTF.  CONFIG_KERNEL_DEBUG_INFO_BTF is
# `depends on KERNEL_DEBUG_INFO && !KERNEL_DEBUG_INFO_REDUCED`, and while the
# tree already sets DEBUG_INFO=y, **DEBUG_INFO_REDUCED defaults to y** — so BTF
# was silently dropped and the kernel shipped no type information.  All three
# are now written together:
#
#   CONFIG_KERNEL_DEBUG_INFO=y
#   CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
#   CONFIG_KERNEL_DEBUG_INFO_BTF=y
#
# This costs real build time and a larger vmlinux (gcc emits full DWARF, then
# pahole — built via `select DWARVES` — deduplicates it into BTF), which is a
# trade this project accepts.
#
# They are written by append_board_stack_config() only when
# ENABLE_EBPF_PROXY_KERNEL is true (the default), because a disabled switch
# would otherwise be a lie.  Do not add them here: a symbol in this file is
# unconditional, and the switch is not.
#
# CONFIG_BPF_EVENTS and CONFIG_XDP_SOCKETS stay off.  Note also that the
# clash-rs eBPF bytecode is compiled by its own release workflow and embedded in
# the prebuilt binary, so BTF here is for the kernel side and BTF/CO-RE
# consumers, not for compiling an eBPF program at build time.

# ------------------------------------------------------- adblock backends ----
# adblock (classic) and adblock-fast both block by handing a domain list to a
# DNS server.  Two packages have to be in the image for the dnsmasq backends
# their LuCI pages offer to actually exist:
#
#   dnsmasq-full   the base image ships the plain `dnsmasq`, which is built
#                  without ipset/nftset support.  `dnsmasq-full` has both and
#                  PROVIDES dnsmasq, so it replaces it.  (nftset also needs the
#                  `nft` tool, which nftables-json already provides.)
#   ipset          dnsmasq.ipset additionally needs the ipset userspace tool and
#                  the ipset netfilter modules.  Without them the page shows
#                  "Please note that dnsmasq.ipset is not supported on this
#                  system." and never offers the mode.
#
# scripts/local-build.sh writes these as =y from append_board_stack_config() and
# verifies them in verify_config(); they are not listed here for the same reason
# the eBPF symbols are not — the script owns the exact set and the switch logic.

# ------------------------------------------------------------ feeds ---------
# wwand is a third-party feed (ddimension/openwrt-repo).  Without this, OpenWrt
# advertises it in the image's /etc/apk/repositories.d/distfeeds.list at
#
#   https://downloads.openwrt.org/snapshots/packages/aarch64_cortex-a53/wwand/packages.adb
#
# which does not exist there, so every `apk update` on the device ends with
# "wget: exited with error 8" and "unexpected end of file".  feeds.mk emits that
# line for any feed whose CONFIG_FEED_<name> is set, and prefixes it with '#' only
# when the value is exactly `m` (include/feeds.mk:60).  CONFIG_FEED_* is used
# nowhere else in the build system — it does not select or install anything — so
# `m` here only suppresses the bogus URL.  The wwand packages themselves reach
# the device through this project's own repository instead.
CONFIG_FEED_wwand=m

# ------------------------------------------------------------ ccache --------
# Compiler cache.  The CI workflow caches ~/.ccache and openwrt/.ccache, but the
# cache was never filled: CONFIG_CCACHE was unset, so every run restored an empty
# directory, saved it back, and rebuilt everything from scratch.  The symbol is
# `bool "Use ccache" if DEVEL` in the top-level Config.in, so it is hidden in a
# normal menuconfig but can still be set here.
#
# CCACHE_DIR is deliberately left empty: unset means OpenWrt uses ./.ccache,
# which is what the workflow caches.
#
# NOTE: this line does NOT survive defconfig on its own.  The symbol is
# `bool "Use ccache" if DEVEL`, so kconfig drops it unless DEVEL is set — and
# DEVEL would add debug information and cost more than the cache saves.
# scripts/local-build.sh therefore re-writes CONFIG_CCACHE after the final
# defconfig; this line is here for documentation and for the case where
# someone builds with DEVEL on.
