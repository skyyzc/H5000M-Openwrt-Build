#!/bin/sh /etc/rc.common
# QModem 模组识别补扫服务（Hiveton H5000M 时序补偿）
#
# 为什么需要它
# ------------
# QModem 识别模组以「USB 接口已配齐 AT 端口」为前提。H5000M 冷启动时
# RG520N-CN 的时序是：
#     8.2s   usb 2-1 被 xhci-mtk 枚举
#    13.6s   qmi_wwan_q 生成 cdc-wdm0 / wwan0
#    14.5s   option 驱动生成 ttyUSB0 - ttyUSB3
#
# 而 QModem 的三条自动触发路径都落在更早或过短的窗口里：
#   1) /etc/init.d/qmodem_init (S80) 的 _try_usb_slot -> add 2-1 usb
#      首轮约 22s 发起；add_modem 内部有 net_devices / valid_at_ports 两道检查，
#      配合 5 次 × 8s（共约 40s）的重试窗口。这 40s 内任何一次检查不过就
#      give up add，且此后不再重试。
#   2) /etc/hotplug.d/usb/20-modem-usb —— 只在 USB 设备出现的那一瞬触发一次。
#   3) /etc/hotplug.d/net/20-modem-net —— 同理，只在该 netdev 出现时触发一次。
#
# 后果：模组永久停留在「未识别」—— ubus call qmodem info
# '{"config_section":"2_1"}' 返回空数组，海狗 CPE 页显示「模组未识别」；
# 但底层数据面（wwan0_1 + udhcpc + 默认路由）其实是通的，极易误判为 5G 故障。
#
# 本服务只做调用方补偿：开机后在若干时间点调用 QModem 官方扫描入口
# /usr/share/qmodem/modem_scan.sh scan usb；全部失败则重启 QModem 的扫描
# daemon（/etc/init.d/qmodem_init）再试一次。
# 不修改 QModem 任何文件、不改动其 uci 配置。删除本文件与 S92 软链即可回退。
#
# ★ 2026-10-08 内存启动实机：为什么必须是「重启 daemon」而不是继续补扫
#   首个 daemon 实例在启动窗口内判定失败后，45s/80s/120s 三个时间点的补扫
#   加手动 qmodem-rescan --now 共 4 次全部复现 "modem profile not matched"；
#   而 /etc/init.d/qmodem_init restart 换出新 daemon 后，第一次 scan 即
#   "added modem section=2_1 name=rg520n-cn type=usb ports=2 valid=2" 并开始拨号。
#   反证：健康 daemon 可被反复重新识别（删掉 uci section 后 scan 立刻重建），
#   说明坏的是那一个 daemon 实例的状态，不是扫描机制。
#
# ★ 为什么不用 procd 管这个服务
#   本脚本只跑一轮阶梯（最长约 8 分钟）后自然退出。原写法用
#       procd_set_param respawn 0 0 0
#   并注释为「不做 respawn」——**语义恰好相反**：procd 的三个 0 表示无限重启，
#   脚本一退出就被立刻再拉起来。实机证据：识别成功后同一秒内出现 8 次以上
#   qmodem-rescan 启动记录（pid 13730/13742/13765/13778/13800/...），形成热循环。
#   所以这里改用传统 init.d（非 procd）在后台起一次，不再自动重启。

START=92
STOP=08

PIDFILE=/var/run/qmodem-rescan.pid

start() {
	# 后台执行，不阻塞 rcS；脚本自带时间点阶梯与 daemon 重启兜底。
	/usr/sbin/qmodem-rescan >/dev/null 2>&1 &
	echo $! >"$PIDFILE"
}

stop() {
	[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
	rm -f "$PIDFILE"
}
